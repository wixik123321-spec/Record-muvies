# Скопируйте в .env или экспортируйте в терминале. Ни один ключ не обязателен:
# без ключей работают свой текст (--text), озвучка Piper и встроенная 2D-анимация.

# Сценарий по теме (Claude): console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Картинки сцен (visuals.provider: openai): platform.openai.com → API keys
OPENAI_API_KEY=

# Облачная озвучка (voice.provider: elevenlabs): elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=

# Где хранить голоса Piper (по умолчанию ~/.cache/shorts_ru/voices)
# SHORTS_RU_VOICES=
